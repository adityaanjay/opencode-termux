{
  "name": "opencode-termux",
  "version": "0.1.0",
  "description": "AI coding agent for Termux Android - clean-room rebuild of opencode",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opencode-termux": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun --watch src/cli.tsx",
    "build": "bun build src/cli.tsx --outdir dist --target bun && cp node_modules/yoga-wasm-web/dist/yoga.wasm dist/",
    "start": "bun dist/cli.js",
    "db:push": "bun src/db/push.ts",
    "db:studio": "bunx drizzle-kit studio",
    "lint": "bunx eslint src --ext .ts,.tsx",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-gradient": "^2.0.0",
    "react": "^18.3.1",
    "drizzle-orm": "^0.33.0",
    "zod": "^3.23.8",
    "@anthropic-ai/sdk": "^0.27.3",
    "openai": "^4.57.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-cpp": "^0.21.0",
    "tree-sitter-json": "^0.21.0",
    "tree-sitter-bash": "^0.21.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-jsonrpc": "^8.2.0",
    "chalk": "^5.3.0",
    "cli-truncate": "^4.0.0",
    "string-width": "^7.2.0",
    "uuid": "^10.0.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "drizzle-kit": "^0.24.2",
    "eslint": "^9.9.1",
    "react-devtools-core": "^8.0.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}